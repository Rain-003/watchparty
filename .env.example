# Watchparty Environment Configuration
# Set these securely in Vercel Project Settings > Environment Variables

# --- Server-Side Security Secrets (Never share publicly) ---
AUTH_SECRET="your-32-character-secret-key-replace-this"
MASTER_PASSCODE="your-secret-owner-master-key"
MASTER_RECOVERY_OTP="your-secret-6-digit-recovery-code"
HOST_PASSCODE="your-secret-host-passcode"
VIEWER_PASSCODE="your-viewer-room-passcode"

# --- Owner 2FA Recovery & Email Settings ---
OWNER_EMAIL="your-email@example.com"
RESEND_API_KEY="" # (Optional: free API key from resend.com for email delivery)
DISCORD_SECURITY_WEBHOOK="" # (Optional: paste discord webhook for instant phone alerts)
EMAIL_FROM="Watchparty Security <onboarding@resend.dev>"

# --- Client-Side UI Defaults ---
VITE_STREAM_TITLE="Community Watchparty"
VITE_PRIMARY_HLS_URL="https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8"
VITE_BACKUP_EMBED_URL="https://www.youtube.com/embed/5qap5aO4i9A?autoplay=1&mute=0"
VITE_DISCORD_URL="https://discord.com"
